# =============================================================================
# MixMaster environment variables
# Copy to `.env.local` for local dev. On Vercel: Project → Settings → Environment Variables.
# Full integration guide: docs/Redis_Sentry_PostHog_INTEGRATION_GUIDE.md
# =============================================================================

# -----------------------------------------------------------------------------
# App (public — embedded in client bundle)
# -----------------------------------------------------------------------------
# Display name in metadata and UI.
NEXT_PUBLIC_APP_TITLE=MixMaster

# Canonical site URL (newsletter links, OpenRouter referrer, metadata).
# Local: http://localhost:3000 | Production: https://your-domain.vercel.app
# Vercel: set for Production + Preview so emails and OG tags resolve correctly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TheCocktailDB API base (public cocktail data).
# Default free tier — no key required: https://www.thecocktaildb.com/api.php
NEXT_PUBLIC_API_BASE_URL=https://www.thecocktaildb.com/api/json/v1/1

# -----------------------------------------------------------------------------
# Resend (newsletter email delivery)
# https://resend.com → API Keys → Create API Key
# Domain: Resend → Domains → add domain → verify DNS (SPF/DKIM) before production sends.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must use a verified domain in production, e.g. MixMaster <newsletter@your-domain.com>
RESEND_FROM_EMAIL=MixMaster <newsletter@your-domain.com>
RESEND_REPLY_TO_EMAIL=contact@your-domain.com

# -----------------------------------------------------------------------------
# Upstash Redis (newsletter subscribers, rate limits, queue)
# https://console.upstash.com → Create Redis database → REST API tab
# Copy REST URL and REST TOKEN (not the redis:// connection string).
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# -----------------------------------------------------------------------------
# Newsletter security (server-only — generate long random strings)
# openssl rand -base64 48
# -----------------------------------------------------------------------------
# Signs one-click unsubscribe links.
NEWSLETTER_UNSUBSCRIBE_SECRET=replace_with_a_long_random_secret
# Optional: separate key for double opt-in confirmation (falls back to UNSUBSCRIBE secret).
NEWSLETTER_CONFIRM_SECRET=replace_with_another_long_random_secret

# -----------------------------------------------------------------------------
# Admin control room (server-only)
# openssl rand -base64 32
# -----------------------------------------------------------------------------
# Passkey for /admin login and API auth.
ADMIN_DASHBOARD_KEY=replace_with_strong_admin_key
# Signs admin session cookie (can match passkey in dev; use a distinct secret in production).
ADMIN_SESSION_SECRET=replace_with_strong_session_secret

# -----------------------------------------------------------------------------
# Cron / digest trigger (server-only)
# Protects POST /api/newsletter/weekly-brief and admin queue processor.
# Vercel Cron: set the same value in cron job Authorization header or ?secret= query.
# openssl rand -base64 32
# -----------------------------------------------------------------------------
CRON_DIGEST_SECRET=replace_with_cron_secret

# -----------------------------------------------------------------------------
# AI newsletter composer assist (admin only, server-only)
# Provider chain: Groq → Gemini → OpenRouter → Hugging Face (skips unconfigured keys).
# Each provider tries its model chain in order; see docs/LLM_MODEL_SELECTION.md.
# -----------------------------------------------------------------------------
# https://console.groq.com → API Keys
GROQ_API_KEY=
# Optional override (single model): GROQ_MODEL=openai/gpt-oss-20b

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or: GOOGLE_AI_API_KEY= (alias for Gemini)
# Optional override: GEMINI_MODEL=gemini-2.5-flash

# https://openrouter.ai/keys — use :free suffix for zero-cost models
OPENROUTER_API_KEY=
# Optional override: OPENROUTER_MODEL=openai/gpt-oss-20b:free

# https://huggingface.co/settings/tokens — fine-grained token with "Make calls to Inference Providers"
HUGGINGFACE_API_KEY=
# Optional override: HUGGINGFACE_MODEL=openai/gpt-oss-20b:fastest

# -----------------------------------------------------------------------------
# Sentry (error monitoring — optional locally, recommended in production)
# https://sentry.io → create project (platform: Next.js)
# Same-origin tunnel: /api/monitoring (bypasses ad blockers in normal + incognito).
# SDK is disabled when DSN is empty — safe for local dev without keys.
# -----------------------------------------------------------------------------
# Browser/client errors — REQUIRED for client-side capture.
# Sentry → Project → Settings → Client Keys (DSN)
# Vercel: set for Production (and Preview if desired) — must be present at BUILD time.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX

# Server alias (optional — falls back to NEXT_PUBLIC_SENTRY_DSN for API/RSC errors).
SENTRY_DSN=

# Source map upload at build time (Vercel only — never exposed to browser).
# SENTRY_ORG = Organization slug (Settings → General), e.g. arnob-mahmuds-org
# SENTRY_PROJECT = PROJECT slug (Project Settings → slug), e.g. cocktail-newsletter
#   ⚠️  Do NOT put the org slug in SENTRY_PROJECT — that breaks source map uploads.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Sentry → Settings → Auth Tokens → Create (scopes: project:releases, org:read)
# Vercel: Production only; omit locally unless testing source map upload.
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Build / CI (optional — already set in package.json build script)
# -----------------------------------------------------------------------------
# NEXT_TELEMETRY_DISABLED=1
